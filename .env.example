# ============================================================
# Acamp Deep — Variáveis de Ambiente
# Copie este arquivo para .env.local (não commitar!)
# Configure no Vercel em: Settings → Environment Variables
# ============================================================

# URL do Apps Script publicado como "Aplicativo da Web"
# Exemplo: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_URL=

# Chaves VAPID para Push Notifications
# Gerar em: https://vapidkeys.com ou via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=suporte@suaigreja.com.br

# Chave pública exposta ao client (service worker)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ============================================================
# AMBIENTES
# ============================================================
# Produção (branch main no Vercel):
#   APPS_SCRIPT_URL = URL do Apps Script de PRODUÇÃO
#   (planilha de produção com dados reais)
#
# Preview (branches de PR no Vercel):
#   APPS_SCRIPT_URL = URL do Apps Script de TESTE
#   (planilha separada para testes, sem afetar dados reais)
#
# Para criar ambientes diferentes no Vercel:
#   Settings → Environment Variables → Selecionar "Preview" ou "Production"
# ============================================================
